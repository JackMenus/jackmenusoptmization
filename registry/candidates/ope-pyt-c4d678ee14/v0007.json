  "source": "# generated by optiforge CodeTemplateGenerator: [('boundary', 'clip'), ('discrete', 'resample'), ('dist', 'laplace'), ('integer', 'round'), ('p_discrete', 0.17), ('perm', 'reverse'), ('rate', 0.59), ('scale', 'sigma_range'), ('select', 'all')]\ndef mutate(x, info, rng):\n    lo, hi, types = info[\"lower\"], info[\"upper\"], info[\"types\"]\n    n = len(x)\n    y = list(x)\n    idx = [i for i in range(n) if types[i] in ('real', 'integer')]\n    for i in idx:\n        v = y[i] + (rng.expovariate(1.0) - rng.expovariate(1.0)) / 1.4142136 * info['sigma'] * (hi[i] - lo[i])\n        v = min(max(v, lo[i]), hi[i])\n        if types[i] == 'integer':\n            v = float(round(v))\n        v = min(max(v, lo[i]), hi[i])\n        y[i] = v\n    for i in range(n):\n        if types[i] == 'binary' and rng.random() < 0.17:\n            y[i] = 1.0 - y[i]\n        elif types[i] == 'categorical' and rng.random() < 0.17:\n            k = int(hi[i]) + 1\n            if k > 1:\n                y[i] = float((int(y[i]) + rng.randrange(1, k)) % k)\n    for a, b in info['perm_blocks']:\n        if b - a >= 2:\n            i, j = sorted(rng.sample(range(a, b), 2))\n            y[i:j + 1] = y[i:j + 1][::-1]\n    return y\n",
